// Construct the Section 4 vector V directly from the residue recurrence.
< "weyl_ring.sing";

// Exponent shifts on the parametrized curve, not spatial variables.
number shiftW=q;
number shiftV=-(8*q^2+8*q+9)/6;
number shiftU=4*q^2-1;
number residueA=shiftV+shiftW+3/2;
number residueK=shiftV+2*shiftW+3/2;
number residueD=2*(shiftV+shiftW+1);

proc factorialInt(int n)
{
  number value=1;
  int idx;
  for(idx=2;idx<=n;idx++){value=value*idx;}
  return(value);
}

proc binomialInt(int n,int k)
{
  return(factorialInt(n)/(factorialInt(k)*factorialInt(n-k)));
}

proc risingFactorial(number arg,int n)
{
  number value=1;
  int idx;
  if(n>=0)
  {for(idx=0;idx<n;idx++){value=value*(arg+idx);}}
  else
  {for(idx=1;idx<=-n;idx++){value=value/(arg-idx);}}
  return(value);
}

matrix hm[31][1];
matrix jm[20][1];
matrix fm[51][1];
int i,j,k,l,n,m,mm,ll,jj;
number numeratorValue,sumValue,coefficientValue,radialValue,baseValue;

// lambda(E1)=residueK, lambda(Em)=shiftV, hence lambda(H0)=0.
hm[1,1]=0;
hm[2,1]=-2*shiftV*residueK/(residueD+1);
for(i=1;i<30;i++)
{
  hm[i+2,1]=((i-1/2)*hm[i,1]+(residueK-shiftV)*hm[i+1,1])
             /(residueD+i+1);
}
jm[1,1]=shiftV;
for(m=2;m<=20;m++)
{
  numeratorValue=2*shiftV*residueK-shiftV*residueK/(2^(m-1));
  for(k=1;k<m;k++)
  {
    numeratorValue=numeratorValue+
      (-1/2+shiftV/(2^(m-k)))*number(jm[k,1]);
  }
  jm[m,1]=numeratorValue/(residueK-m+1);
}

// fm[n+21,1]=lambda((r+1)^n/(1-r)), for -20<=n<=30.
fm[21,1]=-residueK;
for(m=1;m<=20;m++){fm[21-m,1]=(fm[22-m,1]+jm[m,1])/2;}
for(n=1;n<=30;n++)
{
  sumValue=0;
  for(k=0;k<n;k++)
  {sumValue=sumValue+binomialInt(n-1,k)*number(hm[k+1,1]);}
  fm[n+21,1]=2*fm[n+20,1]-sumValue;
}
poly V=0;
for(i=0;3*i<=18;i++)
{
  for(k=0;3*i+2*k<=18;k++)
  {
    for(l=0;3*i+2*k+4*l<=18;l++)
    {
      jj=18-3*i-2*k-4*l;
      n=7-i-k-l;
      m=jj+1;
      mm=27-4*i-3*k-6*l;
      ll=-12+2*i+k+3*l;
      radialValue=risingFactorial(residueA,n)*
        risingFactorial(-residueK,m-n)/risingFactorial(-shiftW,m);
      baseValue=0;
      for(j=0;j<=mm;j++)
      {
        baseValue=baseValue+binomialInt(mm,j)*(-1)^(mm-j)*
          number(fm[ll+j+21,1]);
      }
      coefficientValue=risingFactorial(shiftW-jj,jj)/factorialInt(jj)*
        radialValue*baseValue;
      coefficientValue=(-1)^(i+k+l)*coefficientValue/
        (factorialInt(i)*factorialInt(k)*factorialInt(l));
      // Dx, Dy, Dz commute inside the Weyl algebra; no deltaAction model.
      V=V+coefficientValue*Dx^i*Dy^k*Dz^l;
    }
  }
}

// Save the vector with the functional normalization fixed in Section 4.
// Portable include: the caller must first establish the same Weyl algebra.
link witnessOutput="ASCII:w V.sing";
write(witnessOutput,"// Generated by 1_constructing_V.sing over Q(q); Section 4 V, without rescaling.");
write(witnessOutput,"// Load after defining x,y,z,Dx,Dy,Dz in the Weyl algebra.");
write(witnessOutput,"poly V="+string(V)+";");
close(witnessOutput);
print("CONSTRUCTING_V_COMPLETE");
quit;
