// Construct P_i and their left coefficients by lowest-weight reduction.
// Origin: certificates/construction/build_weighted_bound.sing.
< "inputs/annfs.sing";
ideal B=annFs;
short=0;

proc weightInitial(poly p) {
  int mn=10000;int w;intvec ee;poly t;poly answer;
  while(p!=0) {
    t=lead(p);ee=leadexp(p);p=p-t;
    w=3*(ee[1]-ee[4])+2*(ee[2]-ee[5])+4*(ee[3]-ee[6]);
    if(w<mn) { mn=w;answer=t; }
    else { if(w==mn) { answer=answer+t; } }
  }
  return(answer);
}
proc initialWeight(poly p) {
  intvec ee=leadexp(weightInitial(p));
  return(3*(ee[1]-ee[4])+2*(ee[2]-ee[5])+4*(ee[3]-ee[6]));
}

proc initialNormalize(list pair) {
  number c=leadcoef(weightInitial(pair[1]));
  matrix coefficients=pair[2];int i;
  for(i=1;i<=13;i++) { coefficients[1,i]=coefficients[1,i]/c; }
  return(list(pair[1]/c,coefficients));
}
proc subtractMultiple(list pair,poly multiplier,list reducer) {
  matrix coefficients=pair[2];matrix rc=reducer[2];int i;
  for(i=1;i<=13;i++) { coefficients[1,i]=coefficients[1,i]-multiplier*rc[1,i]; }
  return(list(pair[1]-multiplier*reducer[1],coefficients));
}
proc cancelConstantDerivatives(list pair,list first) {
  int step;intvec ee;poly ini;poly candidate;poly ci;poly multiplier;
  for(step=0;step<200;step++) {
    ini=weightInitial(pair[1]);ee=leadexp(ini);
    if(ee[1]!=1 || ee[2]!=1 || ee[3]!=0 || ee[4]<1) { break; }
    multiplier=Dx^(ee[4]-1)*Dy^ee[5]*Dz^ee[6]*s(1)^ee[7]*s(2)^ee[8]*s(3)^ee[9];
    candidate=multiplier*first[1];ci=weightInitial(candidate);
    if(leadexp(ci)!=ee) { break; }
    multiplier=(leadcoef(ini)/leadcoef(ci))*multiplier;
    pair=subtractMultiple(pair,multiplier,first);
  }
  return(pair);
}
proc cappedWeightedReduction(list pair,list reducers) {
  int step,i,j,chosen,ok;
  intvec ee,ff;
  poly ini,ri,multiplier,candidate,ci;
  for(step=0;step<80;step++) {
    ini=weightInitial(pair[1]);ee=leadexp(ini);chosen=0;
    for(i=1;i<=size(reducers);i++) {
      ri=weightInitial(reducers[i][1]);ff=leadexp(ri);ok=1;
      for(j=1;j<=9;j++) { if(ff[j]>ee[j]) { ok=0; } }
      if(ok) { chosen=i;break; }
    }
    if(chosen==0) { break; }
    multiplier=1;
    for(j=1;j<=9;j++) { multiplier=multiplier*var(j)^(ee[j]-ff[j]); }
    candidate=multiplier*reducers[chosen][1];ci=weightInitial(candidate);
    if(leadexp(ci)!=ee) { ERROR("WEIGHT_REDUCTION_LEAD_MISMATCH"); }
    multiplier=(leadcoef(ini)/leadcoef(ci))*multiplier;
    pair=subtractMultiple(pair,multiplier,reducers[chosen]);
    if(pair[1]==0 || size(pair[1])>30000) { break; }
  }
  return(pair);
}
list originals;
int idx;
matrix unitRow[1][13];
for(idx=1;idx<=13;idx++) {
  unitRow=0;unitRow[1,idx]=1;originals[idx]=list(B[idx],unitRow);
}
list ten=cancelConstantDerivatives(originals[10],originals[1]);
list thirteen=cancelConstantDerivatives(originals[13],originals[1]);
list reducers;
for(idx=1;idx<=12;idx++) { reducers[idx]=originals[idx]; }
reducers[10]=ten;
thirteen=cappedWeightedReduction(thirteen,reducers);
poly iniA=weightInitial(ten[1]);poly iniB=weightInitial(y*Dz*B[1]);
number scale=leadcoef(iniA)/leadcoef(iniB);
list hten=subtractMultiple(ten,scale*y*Dz,originals[1]);
iniA=weightInitial(thirteen[1]);iniB=weightInitial(Dz^2*hten[1]);
scale=leadcoef(iniA)/leadcoef(iniB);
if(iniA!=scale*iniB) { ERROR("G13_NEXT_NOT_H10_MULTIPLE"); }
thirteen=subtractMultiple(thirteen,scale*Dz^2,hten);
reducers[10]=hten;
thirteen=cappedWeightedReduction(thirteen,reducers);
list one=initialNormalize(originals[1]);
hten=initialNormalize(hten);
thirteen=initialNormalize(thirteen);
list certified=list(one,hten,thirteen);
poly identityCheck;matrix leftCoefficients;int jdx;
for(idx=1;idx<=3;idx++) {
  identityCheck=0;leftCoefficients=certified[idx][2];
  for(jdx=1;jdx<=13;jdx++) { identityCheck=identityCheck+leftCoefficients[1,jdx]*B[jdx]; }
  if(identityCheck!=certified[idx][1]) {
    ERROR("LEFT_PBW_IDENTITY_FAILURE");
  }
  print("LEFT_PBW_IDENTITY_"+string(idx)+"_EXACT_PASS");
}
poly euler=3*x*Dx+2*y*Dy+4*z*Dz;
poly totalS=2*s(1)+6*s(2)+8*s(3);
if(initialWeight(one[1])!=2 || initialWeight(hten[1])!=0 || initialWeight(thirteen[1])!=-6) {
  ERROR("MINIMUM_WEIGHT_FAILURE");
}
if(weightInitial(one[1])!=y*(euler-totalS)/3) { ERROR("ONE_INITIAL_FAILURE"); }
if(weightInitial(hten[1])!=(z*Dz+1)*(euler-totalS)/3) { ERROR("HTEN_INITIAL_FAILURE"); }
print("INITIAL_WEIGHTS_2_0_MINUS6_EXACT_PASS");
print("ONE_HTEN_INITIAL_EULER_FACTORS_EXACT_PASS");
poly lastInitial=weightInitial(thirteen[1]);
// :w overwrites this generated output; reruns do not append duplicate declarations.
link operatorOutput=":w operators.sing";
write(operatorOutput,"// Generated by 3_initial_term18.sing. Read inputs/annfs.sing first.");
write(operatorOutput,"// P_i = sum_j boundLefti[1,j] * B[j]; LEFT Weyl multiplication.");
for(idx=1;idx<=3;idx++)
{
  write(operatorOutput,"poly boundOperator"+string(idx)+"="+string(certified[idx][1])+";");
  write(operatorOutput,"matrix boundLeft"+string(idx)+"[1][13]="+string(certified[idx][2])+";");
}
write(operatorOutput,"poly boundLastInitial="+string(lastInitial)+";");
close(operatorOutput);
print("CONSTRUCT_OPERATORS_EXACT_PASS");
quit;
